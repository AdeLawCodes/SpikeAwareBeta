<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/graphRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:paddingStart="20dp"
    android:paddingEnd="20dp"
    android:paddingBottom="20dp"
    android:background="@android:color/white">

    <TextView
        android:id="@+id/tvGraphTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Reported spiking incidents (Jan 2021 – Feb 2025)"
        android:textStyle="bold"
        android:textSize="20sp"
        android:paddingTop="12dp"
        android:paddingBottom="10dp"
        android:textColor="@color/spike_purple"/>

    <!-- Toggle (Line / Bar) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingBottom="10dp">

        <Button
            android:id="@+id/btnLine"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:text="Line"
            android:textAllCaps="false"
            android:textColor="@android:color/white"
            android:background="@drawable/btn_purple_square"/>

        <Space
            android:layout_width="12dp"
            android:layout_height="match_parent" />

        <Button
            android:id="@+id/btnBar"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:text="Bar"
            android:textAllCaps="false"
            android:textColor="@android:color/white"
            android:background="@drawable/btn_purple_square"/>
    </LinearLayout>

    <!-- Chart area -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="360dp">

        <com.example.spikeawarebeta.LineChartView
            android:id="@+id/lineChart"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <com.example.spikeawarebeta.BarChartViewSimple
            android:id="@+id/barChart"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone" />
    </FrameLayout>

    <TextView
        android:id="@+id/tvYearTotalsTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Year totals (2021–2025)"
        android:textStyle="bold"
        android:textSize="16sp"
        android:paddingTop="14dp"
        android:paddingBottom="8dp"
        android:textColor="#222222"/>

    <com.example.spikeawarebeta.BarChartViewSimple
        android:id="@+id/yearBarChart"
        android:layout_width="match_parent"
        android:layout_height="240dp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingTop="12dp"
        android:text="Source: Monthly reported incidents dataset (Jan 2021–Feb 2025)."
        android:textSize="13sp"
        android:textColor="#666666"/>
</LinearLayout>
